<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WorldTimeZoneClock</AssemblyName>
    <RootNamespace>ActuallyUsableWorldTimeClock2</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Build #15 (§7.1): installer.ico as the exe's Win32 icon resource
         (Explorer + future MSIX packaging reuse it). -->
    <ApplicationIcon>assets\installer.ico</ApplicationIcon>

    <!-- This project's directory IS the repository root, so the SDK's default
         **/*.cs (and resource) globs would otherwise sweep the nested test
         project's sources into the APP and die on its xUnit references
         (CS0246 — first compile of build #10, App. B B10). DefaultItemExcludes
         is consulted by every default glob, so one line keeps the whole
         tests subtree (incl. any future tests/**/obj generated sources) out
         of the app compilation; the test project globs its own directory
         (App. B B11). Property evaluation precedes item evaluation, so an
         in-body setting is honored by the SDK's globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>

    <!-- Build #12 (§4/§14): Per-Monitor V2 DPI awareness, declared in app.manifest —
         embedded into the exe here (nothing is generated without this property).
         WPF on .NET 8 does not reliably default to PMv2 (dotnet/wpf#859), and the
         px↔DIP policy (§9.1) is correct only under per-monitor awareness. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Version protocol: patch digit = build number. Bump ONLY when source
         changed; incremental no-op builds keep the version (so a stale exe
         is instantly detectable: binary version < current source version). -->
    <VersionPrefix>0.0.15</VersionPrefix>
    <FileVersion>0.0.15</FileVersion>
    <InformationalVersion>0.0.15-build15-tray-icons</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build #15 (§7.1): the DPI-rung tray PNGs, embedded as assembly
         resources so the single-file self-contained publish carries them
         INSIDE the bundle (loose Content files would land outside it).
         Loaded by TrayIconAssets via GetManifestResourceStream → GDI+ → HICON. -->
    <EmbeddedResource Include="assets\tray_16.png" />
    <EmbeddedResource Include="assets\tray_20.png" />
    <EmbeddedResource Include="assets\tray_24.png" />
    <EmbeddedResource Include="assets\tray_32.png" />
    <EmbeddedResource Include="assets\tray_48.png" />
    <EmbeddedResource Include="assets\tray_64.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build #15: GDI+ (Bitmap → GetHicon) for the PNG→HICON conversion —
         the main project's first NuGet dependency. Windows-only package,
         consistent with net8.0-windows. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Stamp the OutDir with a build-info.txt we can read as text to verify
       which binary is actually deployed (mtime tracking is unreliable here). -->
  <Target Name="StampBuildInfo" AfterTargets="Build"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <WriteLinesToFile
        File="$(OutDir)build-info.txt"
        Lines="version=$(InformationalVersion);built=$([System.DateTime]::UtcNow.ToString('o')) config=$(Configuration) rid=$(RuntimeIdentifier)"
        Overwrite="true" />
  </Target>

</Project>