<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WorldTimeZoneClock</AssemblyName>
    <RootNamespace>ActuallyUsableWorldTimeClock2</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- This project's directory IS the repository root, so the SDK's default
         **/*.cs (and resource) globs would otherwise sweep the nested test
         project's sources into the APP and die on its xUnit references
         (CS0246 — first compile of build #10, App. B B10). DefaultItemExcludes
         is consulted by every default glob, so one line keeps the whole
         tests subtree (incl. any future tests/**/obj generated sources) out
         of the app compilation; the test project globs its own directory
         (App. B B11). Property evaluation precedes item evaluation, so an
         in-body setting is honored by the SDK's globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>

    <!-- Version protocol: patch digit = build number. Bump ONLY when source
         changed; incremental no-op builds keep the version (so a stale exe
         is instantly detectable: binary version < current source version). -->
    <VersionPrefix>0.0.11</VersionPrefix>
    <FileVersion>0.0.11</FileVersion>
    <InformationalVersion>0.0.11-build11-test-glob-exclusion</InformationalVersion>
  </PropertyGroup>

  <!-- Stamp the OutDir with a build-info.txt we can read as text to verify
       which binary is actually deployed (mtime tracking is unreliable here). -->
  <Target Name="StampBuildInfo" AfterTargets="Build"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <WriteLinesToFile
        File="$(OutDir)build-info.txt"
        Lines="version=$(InformationalVersion);built=$([System.DateTime]::UtcNow.ToString('o')) config=$(Configuration) rid=$(RuntimeIdentifier)"
        Overwrite="true" />
  </Target>

</Project>