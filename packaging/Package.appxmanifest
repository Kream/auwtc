<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest — build #16 (design doc §15.3): Version="0.0.16.0" ↔
  main .csproj VersionPrefix/FileVersion 0.0.16 (Revision pinned at 0 per §15.3).

  SHAPE: full-trust desktop-bridge package for the packaged WPF app (NOT an
  AppContainer app) — EntryPoint MUST be "Windows.FullTrustApplication" and the
  runFullTrust restricted capability is required (MS Learn, "Set up your desktop
  application for MSIX packaging in Visual Studio"); TargetDeviceFamily floor is
  the desktop-bridge minimum, 10.0.14393.0 (1607).

  SIGNING (self-signed sideload, decided 2026-11-03): Publisher MUST equal the
  signing certificate's Subject EXACTLY. Visual Studio's package wizard creates
  the test certificate to match this Publisher value — if you change the
  Publisher here, change the certificate subject to match (or vice versa).

  ASSETS: each logo role requires an EXACT square size (MSIX validator): StoreLogo 50×50,
  Square150x150Logo 150×150, Square44x44Logo 44×44. The sized PNGs are generated
  from assets\installer_256.png (ImageMagick, user-run) and Content-LINKED from
  ..\assets\ into the package's Assets\ by the packaging project (.wapproj) —
  the 256×256 master stays the single source. The signing certificate (.pfx)
  is a SECRET: it is gitignored, never committed.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

  <!-- §15.3: Version = 0.0.<build>.0 — build #16. x64 matches the main
       csproj's win-x64 self-contained publish. -->
  <Identity Name="WorldTimeZoneClock"
            Version="0.0.16.0"
            Publisher="CN=Kream"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>World Time Zone Clock</DisplayName>
    <PublisherDisplayName>Kream</PublisherDisplayName>
    <Description>A minimal tray world clock (LAX, JFK, LHR, CHC) with a borderless popup.</Description>
    <Logo>Assets\installer_50.png</Logo>
  </Properties>

  <!-- Full-trust desktop bridge: Desktop device family only, from the
       desktop-bridge floor (1607 / 14393) up to the tested maximum. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.14393.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <!-- Restricted capability required for the Windows.FullTrustApplication
       entry point (fine for sideload; Store submission would need review). -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!-- Executable = the main project's AssemblyName (WorldTimeZoneClock.exe).
         EntryPoint is the full-trust desktop-bridge entry point. -->
    <Application Id="App"
                  Executable="WorldTimeZoneClock.exe"
                  EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="World Time Zone Clock"
        Description="A minimal tray world clock (LAX, JFK, LHR, CHC) with a borderless popup."
        BackgroundColor="#F5F5F5"
        Square150x150Logo="Assets\installer_150.png"
        Square44x44Logo="Assets\installer_44.png" />
    </Application>
  </Applications>
</Package>