<!-- §7.2: Consolas 12 pt — WPF FontSize is in device-independent pixels, so 12 pt = 16. -->
<Window x:Class="ActuallyUsableWorldTimeClock2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Time Zone Clock"
        Width="180"
        Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Background="#FFF5F5F5"
        FontFamily="Consolas"
        FontSize="16">

    <!-- §7.2/§13: one row per CityTimeRow; city name left, snapshot time right. -->
    <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Rows="3" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="12,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding City.Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Time}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
