<!-- §7.2 (v4.4): Consolas 12 pt = FontSize 16 DIP (WPF FontSize is DIP, 96/inch).
     Size: Width 180 DIP is MANUAL (SizeToContent="Height" never sizes width —
     it is the authoritative X term, §9); HEIGHT is content-sized: one natural
     row per city, any count (§13) — the popup grows with the city list.
     Physically 270 × <content> px at 150% scaling. -->
<Window x:Class="ActuallyUsableWorldTimeClock2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Time Zone Clock"
        Width="180"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Background="#FFF5F5F5"
        FontFamily="Consolas"
        FontSize="16">

    <!-- §7.2/§13: one row per CityTimeRow; city name left, snapshot time right. -->
    <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- §13 (v4.4): vertical StackPanel — one natural-height row per
                     city, ANY count. (The old UniformGrid Rows="3" hardcoded three
                     rows and equalized cell heights — the literal §13 bug.) -->
                <StackPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- Margin 12,4 DIP (§9.1 audit — layout values are DIP-native):
                     the 4-DIP vertical margin restores the row rhythm the old
                     UniformGrid (Rows=3 over a fixed 100-DIP height) supplied
                     by equal distribution. -->
                <Grid Margin="12,4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Fixed 180-DIP width + content-sized height ⇒ over-wide
                         names CLIP; CharacterEllipsis keeps the layout stable
                         (§7.2/§9: the width term stays the manual 180 DIP). -->
                    <TextBlock Text="{Binding City.Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Time}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>